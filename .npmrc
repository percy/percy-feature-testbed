# .npmrc — dependency / supply-chain hardening (added per security ticket)

# Pin exact versions written by `npm install` (no caret ranges -> no silent upgrades).
save-exact=true

# Surface known vulnerabilities on install; keep output clean.
audit=true
fund=false

# --- Approved/internal registry --------------------------------------------------
# npm defaults to the public registry (https://registry.npmjs.org/). If the security
# policy mandates installs go through an approved internal mirror/proxy, set these
# (auth is read from an env var — never commit a token):
# registry=https://<approved-registry>/
# always-auth=true
# //<approved-registry>/:_authToken=${NPM_TOKEN}

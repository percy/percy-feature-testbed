# .npmrc — supply-chain hardening
# Required by BrowserStack Supply Chain Security audit (PER-10291 / SC-12282, Enigma).
# Tech spec: ENG > Supply Chain Security Enhancements.

ignore-scripts=true      # block malicious dependency lifecycle scripts
strict-ssl=true          # enforce TLS to the registry
save-exact=true          # pin exact versions (no caret ranges)
audit-level=high         # fail on high+ severity advisories
engine-strict=true       # refuse incompatible Node engines
legacy-peer-deps=false   # preserve npm 7+ peer-dependency resolution
access=restricted        # private-package default (private repo)
